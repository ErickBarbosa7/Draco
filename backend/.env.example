# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/draco?schema=public"

# Secreto JWT (obligatorio en producción; usa una cadena larga y aleatoria)
JWT_SECRET="cambia-esta-clave-en-produccion"

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:4000"

# Puerto del servidor
PORT=4000

# URL del frontend en producción (solo si la app de escritorio apunta al backend remoto)
# VITE_API_URL="https://draco-645n.onrender.com"
